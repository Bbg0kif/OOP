LTEXT "Go back or click OK to finish.", -1, 10, 30, 220, 12

PUSHBUTTON "< Back", IDC_BACK_MOD3, 40, 63, 60, 16
DEFPUSHBUTTON "OK", IDOK, 110, 63, 55, 16
PUSHBUTTON "Cancel", IDCANCEL, 175, 63, 55, 16
END
