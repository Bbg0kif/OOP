#include <windows.h>
#include "module3.rh"

IDD_DIALOG_MOD3 DIALOGEX 0, 0, 240, 90
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Work2 - Step 2"
FONT 9, "Segoe UI"
BEGIN
